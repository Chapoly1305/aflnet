FROM ubuntu:24.04

# Fuzz-only runtime. Coverage replay and aggregation run after the campaign on
# the host and are deliberately not part of this image.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libglib2.0-0 libmount1 libblkid1 libselinux1 libffi8 libpcre2-8-0 \
      libstdc++6 libgcc-s1 zlib1g libcgraph6 libcdt5 libcap2 coreutils procps && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY afl-fuzz /opt/aflnet/afl-fuzz
COPY aflnet-chip-all-clusters-app-fuzz /opt/fuzzer/aflnet-chip-all-clusters-app-fuzz
COPY seeds/ /opt/fuzzer/seeds/
COPY matter.dict /opt/fuzzer/matter.dict
COPY entrypoint.sh snapshot.sh runtime.sha256 /opt/fuzzer/

RUN mkdir -p /workdir/output && \
    chmod +x /opt/aflnet/afl-fuzz \
             /opt/fuzzer/aflnet-chip-all-clusters-app-fuzz \
             /opt/fuzzer/entrypoint.sh /opt/fuzzer/snapshot.sh

ENV AFL_SKIP_CPUFREQ=1 \
    AFL_NO_AFFINITY=1 \
    AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1 \
    AFL_SKIP_CRASHES=1 \
    ASAN_OPTIONS=abort_on_error=1:symbolize=0:detect_leaks=0:allocator_may_return_null=1 \
    DEBUGINFOD_URLS="" \
    AFLNET=/opt/aflnet \
    AFL_PATH=/opt/aflnet \
    FUZZ_PORT=5560 \
    TRANSPORT=udp \
    DELAY_US=10000 \
    POLL_MS=100 \
    FUZZ_SECONDS=86400 \
    SNAPSHOT_INTERVAL=1800 \
    CALIBRATION_GUARD_SECONDS=172800 \
    AFL_ALGO_FLAGS="-d -q 3 -s 3 -E -K -R" \
    DICT=/opt/fuzzer/matter.dict \
    TEST_TIMEOUT_MS=3000

WORKDIR /opt/fuzzer
ENTRYPOINT ["/opt/fuzzer/entrypoint.sh"]
